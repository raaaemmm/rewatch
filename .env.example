# Rewatch settings. Copy this file to .env and edit it:  cp .env.example .env
#
# Every setting starts with REWATCH_. Lines that begin with # show the default value
# and are ignored, so uncomment a line only when you want to change it.
# Works the same for `python start_server.py`, uvicorn and `docker compose up`.

# Required
# Signs the per-download tokens. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Leave it empty and a random key is made on every start, so downloads that are
# open in a browser tab stop working after a restart. `docker compose up` refuses
# to start while this is empty.
REWATCH_SECRET_KEY=

# Your site's address (links, share previews, SEO)
# Full public address, no trailing slash. Used for the canonical link, the preview
# image in WhatsApp/Telegram/Discord/X and sitemap.xml. Empty = taken from each
# request, which is fine on one hostname but wrong behind some tunnels or proxies.
# REWATCH_PUBLIC_URL=https://rewatch.example.com

# Trust CF-Connecting-IP / X-Forwarded-For / X-Forwarded-Proto. Turn on ONLY when
# the app is reached through Cloudflare or a proxy you control (and the port is not
# open on your LAN), otherwise visitors can fake their IP and skip the rate limit.
# REWATCH_TRUST_PROXY_HEADERS=false

# Limits
# Downloads that run at the same time.
# REWATCH_MAX_CONCURRENT_DOWNLOADS=2
# New downloads are refused (HTTP 429) once this many are waiting.
# REWATCH_MAX_QUEUED_JOBS=50
# Most videos taken from one playlist link.
# REWATCH_MAX_PLAYLIST_ITEMS=50
# Most links accepted in one go (also shown in the UI).
# REWATCH_MAX_URLS_PER_BATCH=25
# Longest video accepted, in seconds. 0 = no limit. Default is 4 hours.
# REWATCH_MAX_DURATION_SECONDS=14400
# Biggest file accepted, in MB. 0 = no limit.
# REWATCH_MAX_FILESIZE_MB=2048
# Requests per minute from one visitor. 0 = off. docker-compose.yml uses 120.
# REWATCH_RATE_LIMIT_PER_MINUTE=30
# Give up reading a link's details after this many seconds.
# REWATCH_INFO_TIMEOUT_SECONDS=60
# Give up on a download after this many seconds. Default is 30 minutes.
# REWATCH_DOWNLOAD_TIMEOUT_SECONDS=1800

# Storage
# Finished files are deleted this many seconds after they're ready.
# REWATCH_FILE_TTL_SECONDS=1800
# How often the cleanup runs, in seconds.
# REWATCH_CLEANUP_INTERVAL_SECONDS=60
# Where files are written while they download. The Docker image sets /app/downloads.
# REWATCH_DOWNLOAD_DIR=./downloads
# Folder holding the web page (index.html, css, js, icons). Leave it alone unless
# you moved the static folder.
# REWATCH_STATIC_DIR=./static

# Which links are allowed
# Only allow these sites, comma-separated, e.g. youtube.com,youtu.be. Empty = any public website.
# REWATCH_ALLOWED_HOSTS=
# Allow links that point at private, local or LAN addresses (SSRF protection).
# Keep this off unless you really know you need it.
# REWATCH_ALLOW_PRIVATE_URLS=false

# Media quality
# Prefer H.264 video and AAC audio so MP4s play on iPhones, Windows and TVs.
# REWATCH_PREFER_COMPATIBLE_CODECS=true
# Default MP3 quality in kbps.
# REWATCH_AUDIO_BITRATE_KBPS=192
# Full path to Deno (needed for full YouTube quality lists) if it isn't on your
# PATH, e.g. C:\Users\you\.deno\bin\deno.exe on Windows.
# REWATCH_DENO_PATH=